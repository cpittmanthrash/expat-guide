        cost: { score: 3, label: "Moderate", monthly: "$3,000–5,000", rent: "$1,500–2,500/mo (2BR, Tokyo; cheaper in Osaka/Kyoto)", notes: "More affordable than its reputation. JPY weakness has made Japan cheap for USD earners. Outside Tokyo significantly cheaper." },
        schooling: { score: 3, summary: "Public schools open to expat children. Instruction in Japanese — immersive but demanding. International schools widely available in Tokyo/Osaka.", details: ["Public elementary school open to expat children — free","Instruction entirely in Japanese","Many international schools in Tokyo (American, British, etc.) — $15,000–25,000/yr","At age 4: yochien (kindergarten) — public or private","Excellent educational culture but language barrier is real","Expat children often thrive in immersion schools"] },
        pet: { score: 1, label: "Hardest", summary: "⚠️ Japan requires a 180-day waiting period after a rabies titer blood test before your cat can arrive. START 7+ MONTHS BEFORE YOU MOVE. Non-compliance means up to 180-day quarantine.", details: ["ISO microchip (must be implanted FIRST)","Two rabies vaccinations minimum","Rabies antibody titer test at USDA-approved lab","180-day waiting period after titer test — this is the key bottleneck","Notify Japan's AQS 40 days before arrival","If all requirements met: 12-hour inspection on arrival","If not met: up to 180-day quarantine (very stressful for cats)","START PROCESS 7+ MONTHS BEFORE MOVING"] },
        transit: { score: 5, label: "World-Class", summary: "Japan's train/subway system is the best in the world. Tokyo, Osaka, Kyoto are all supremely walkable and transit-rich. Car completely unnecessary.", details: ["Tokyo: 13 subway lines + JR + private railways","99.9% on-time reputation","IC card (Suica/Pasmo) works everywhere","Bicycling extremely common and safe","Extremely walkable neighborhoods","No car ever needed"] },
        flights: { score: 2, summary: "NRT/HND to IAD: ~13–14 hrs nonstop. Long haul with a 4-year-old. Fares $700–1,200 RT. Expensive and exhausting.", hub: "NRT → IAD/JFK → ORF/RIC" },
        safety: { score: 5, label: "Safest", summary: "Japan is among the safest countries in the world. Virtually no violent crime. Children play outside unsupervised. Extraordinarily safe for families." },
        english: { score: 2, summary: "Limited English in daily life outside tourist areas. Signage is often bilingual. Apps like Google Translate are essential. Expat community in Tokyo is supportive." },
        pros: ["Safest country on the list","World-class transit","Extraordinary culture & food","Affordable with strong USD","Unique life experience"],
        cons: ["⚠️ Cat requires 7+ months advance prep","Language barrier significant","Long flight from East Coast","Complex visa for full year","Cultural adjustment is steep"]
      },
      {
        id: "oslo", name: "Oslo", country: "Norway", flag: "🇳🇴", region: "Europe",
        tagline: "Spectacular nature, sky-high prices",
        visa: { score: 3, label: "Moderate", summary: "Norway is Schengen but NOT EU. US citizens get 90 days visa-free. For a full year, apply for an Independent Means visa at the Norwegian Embassy. Income requirement is high.", details: ["90-day Schengen entry visa-free","Independent Means residence permit: must show sufficient funds to live without working","No official threshold published, but expect to demonstrate ~$50,000+/year","Apply at Royal Norwegian Embassy in Washington, D.C.","Processing time: 3–6 months","Norway is NOT in the EU but follows Schengen rules","Remote workers: technically not permitted to work for foreign employers without a permit","Complex, less common pathway than Spain or France"], difficulty: "Moderate-Hard" },
        cost: { score: 1, label: "Most Expensive", monthly: "$7,000–11,000", rent: "$3,000–5,000/mo (2BR, Oslo)", notes: "Oslo is one of the most expensive cities on Earth. Almost everything costs significantly more than anywhere else on this list." },
        schooling: { score: 4, summary: "World-class free public schools. Norwegian instruction. At 4, children attend barnehage (kindergarten) — heavily subsidized. International schools available.", details: ["Barnehage (kindergarten) heavily subsidized — max ~$300–400/mo","Free elementary school from age 6","Oslo International School (OIS) available — expensive (~$20,000/yr)","Norwegian instruction in public schools","High quality — Norway consistently ranks among world's best education systems"] },
        pet: { score: 3, label: "Moderate", summary: "Norway uses EU-equivalent pet rules. Microchip + rabies + USDA health cert. No quarantine if compliant.", details: ["ISO microchip","Rabies vaccine (21+ days before arrival)","USDA-endorsed health certificate","Norway follows EU pet passport scheme equivalently","No quarantine if compliant","Dogs need tapeworm treatment 1–5 days before arrival"] },
        transit: { score: 5, label: "Excellent", summary: "Oslo ranked top 3 most walkable European city centers. Excellent T-bane (metro), trams, buses. Very bikeable. Car not needed.", details: ["T-bane (metro): 6 lines","Trams + buses throughout city","Ruter app covers all transit","Excellent cycling infrastructure","Ranked top 3 most walkable European city centers","Car unnecessary in Oslo proper"] },
        flights: { score: 3, summary: "OSL has direct flights to JFK/EWR/IAD. ~8–9 hrs. Scandinavian Airlines, United, etc. Less frequent than CDG or LHR. Fares $500–800 RT.", hub: "OSL → IAD/EWR → ORF/RIC" },
        safety: { score: 5, label: "Safest", summary: "Among the safest cities and countries in the world. Extremely family-friendly. Virtually no violent crime." },
        english: { score: 5, label: "Best", summary: "Norwegians speak English exceptionally well — often better than most Americans expect. Nearly universal English fluency. Easy daily life without Norwegian." },
        pros: ["Exceptional English skills","World's safest city","Stunning nature (fjords, skiing)","Top-ranked walkability","Excellent subsidized childcare"],
        cons: ["Most expensive city on list (with London)","Visa pathway complex","Extremely high cost of living","Dark winters","Far from US"]
      }
    ];

    const categories = [
      { id: "visa", label: "Visa / Logistics", icon: "✈️" },
      { id: "cost", label: "Affordability", icon: "💰" },
      { id: "transit", label: "Transit / Walkability", icon: "🚶" },
      { id: "schooling", label: "Child Education", icon: "🎒" },
      { id: "pet", label: "Cat Import", icon: "🐱" },
      { id: "safety", label: "Safety", icon: "🛡️" },
      { id: "flights", label: "Flights Home", icon: "🛫" },
      { id: "english", label: "English Friendliness", icon: "🗣️" },
    ];

    const ScoreDots = ({ score, max = 5 }) => (
      <div style={{ display: "flex", gap: 3 }}>
        {Array.from({ length: max }).map((_, i) => (
          <div key={i} style={{ width: 8, height: 8, borderRadius: "50%", backgroundColor: i < score ? "#22c55e" : "#e2e8f0" }} />
        ))}
      </div>
    );

    const getRankings = (categoryId) =>
      [...destinations].sort((a, b) => (b[categoryId]?.score || 0) - (a[categoryId]?.score || 0)).map((d, i) => ({ ...d, rank: i + 1 }));

    function App() {
      const [view, setView] = useState("overview");
      const [selectedDest, setSelectedDest] = useState(null);
      const [selectedCategory, setSelectedCategory] = useState("visa");
      const ranked = getRankings(selectedCategory);

      return (
        <div style={{ fontFamily: "'Georgia', 'Times New Roman', serif", backgroundColor: "#faf9f7", minHeight: "100vh", color: "#1a1a1a" }}>
          {/* Header */}
          <div style={{ background: "linear-gradient(135deg, #1e3a5f 0%, #2d5986 50%, #1a4a73 100%)", padding: "2rem", color: "white", borderBottom: "4px solid #c9a84c" }}>
            <div style={{ maxWidth: 960, margin: "0 auto" }}>
              <div style={{ fontSize: 11, letterSpacing: "0.2em", textTransform: "uppercase", color: "#c9a84c", marginBottom: 8 }}>Family Expat Guide 2025–2026</div>
              <h1 style={{ fontSize: "clamp(1.4rem, 4vw, 2.4rem)", fontWeight: "normal", margin: 0, lineHeight: 1.2 }}>Where in the World Should<br />Your Family Live for a Year?</h1>
              <p style={{ fontSize: 13, color: "#b8cfe8", marginTop: 8, marginBottom: 0 }}>US citizens • 2 adults + 1 child (age 4) + 1 cat • Car-free living preferred • Flying home to VA/DC easily</p>
            </div>
          </div>

          {/* Nav */}
          <div style={{ background: "#fff", borderBottom: "1px solid #e2e8f0", position: "sticky", top: 0, zIndex: 10, boxShadow: "0 1px 3px rgba(0,0,0,0.06)" }}>
            <div style={{ maxWidth: 960, margin: "0 auto", display: "flex" }}>
              {[{ id: "overview", label: "📋 Overview" }, { id: "rankings", label: "🏆 Rankings" }, { id: "detail", label: "🔍 Destination Detail" }].map(tab => (
                <button key={tab.id} onClick={() => setView(tab.id)} style={{ padding: "0.8rem 1.2rem", border: "none", background: "none", cursor: "pointer", fontSize: 13, fontWeight: view === tab.id ? "600" : "normal", color: view === tab.id ? "#1e3a5f" : "#666", borderBottom: view === tab.id ? "3px solid #1e3a5f" : "3px solid transparent" }}>
                  {tab.label}
                </button>
              ))}
            </div>
          </div>

          <div style={{ maxWidth: 960, margin: "0 auto", padding: "1.5rem 1rem" }}>

            {/* OVERVIEW */}
            {view === "overview" && (
              <div>
                <p style={{ color: "#555", fontSize: 13, marginBottom: 16 }}>Scored 1–5 in each category. Click any destination row to see full details.</p>
                <div style={{ overflowX: "auto" }}>
                  <table style={{ width: "100%", borderCollapse: "collapse", fontSize: 12 }}>
                    <thead>
                      <tr style={{ background: "#1e3a5f", color: "white" }}>
                        <th style={{ padding: "10px 12px", textAlign: "left", fontWeight: 500 }}>Destination</th>
                        {categories.map(c => (
                          <th key={c.id} style={{ padding: "10px 8px", textAlign: "center", fontWeight: 500, whiteSpace: "nowrap" }}>
                            {c.icon}<br /><span style={{ fontSize: 10 }}>{c.label}</span>
                          </th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {destinations.map((d, i) => (
                        <tr key={d.id} onClick={() => { setSelectedDest(d); setView("detail"); }}
                          style={{ cursor: "pointer", background: i % 2 === 0 ? "#fff" : "#f8f9fb", borderBottom: "1px solid #e8eef4" }}
                          onMouseEnter={e => e.currentTarget.style.background = "#e8f0fb"}
                          onMouseLeave={e => e.currentTarget.style.background = i % 2 === 0 ? "#fff" : "#f8f9fb"}>
                          <td style={{ padding: "10px 12px" }}>
                            <span style={{ fontSize: 16 }}>{d.flag}</span>{" "}<strong style={{ fontSize: 13 }}>{d.name}</strong>
                          </td>
                          {categories.map(c => {
                            const score = d[c.id]?.score || 0;
                            const color = score >= 4 ? "#16a34a" : score === 3 ? "#ca8a04" : score <= 1 ? "#dc2626" : "#ea580c";
                            return (
                              <td key={c.id} style={{ textAlign: "center", padding: "10px 8px" }}>
                                <div style={{ display: "inline-flex", alignItems: "center", justifyContent: "center", width: 24, height: 24, borderRadius: "50%", backgroundColor: color, color: "white", fontSize: 11, fontWeight: "bold" }}>{score}</div>
                              </td>
                            );
                          })}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <div style={{ marginTop: 12, display: "flex", gap: 16, flexWrap: "wrap", fontSize: 11, color: "#666" }}>
                  {[["#16a34a", "5 = Excellent"], ["#ca8a04", "3–4 = Good/OK"], ["#dc2626", "1–2 = Challenging"]].map(([color, label]) => (
                    <div key={label} style={{ display: "flex", alignItems: "center", gap: 4 }}>
                      <div style={{ width: 10, height: 10, borderRadius: "50%", backgroundColor: color }} />{label}
                    </div>
                  ))}
                </div>
                <div style={{ marginTop: 24, padding: "1rem 1.25rem", background: "#fef3c7", border: "1px solid #f59e0b", borderRadius: 8 }}>
                  <strong style={{ fontSize: 13, color: "#92400e" }}>⚠️ Key Flags for Your Family</strong>
                  <ul style={{ margin: "8px 0 0 0", paddingLeft: 18, fontSize: 13, color: "#78350f", lineHeight: 1.8 }}>
                    <li><strong>Japan:</strong> Your cat requires 7+ months of advance prep (180-day rabies waiting period). Start NOW if interested.</li>
                    <li><strong>London:</strong> No clear 1-year visa pathway for US citizens without a job offer or specific qualifying category.</li>
                    <li><strong>Costa Rica:</strong> Car is essentially required outside San José — conflicts with your car-free preference.</li>
                    <li><strong>Canada (both cities):</strong> Only 6 months automatic; extending to a full year requires filing for a Visitor Record before the 6 months expire.</li>
                    <li><strong>Spain NLV:</strong> Since May 2025, NO remote work is permitted — even online for foreign employers.</li>
                  </ul>
                </div>
              </div>
            )}

            {/* RANKINGS */}
            {view === "rankings" && (
              <div>
                <div style={{ display: "flex", flexWrap: "wrap", gap: 8, marginBottom: 20 }}>
                  {categories.map(c => (
                    <button key={c.id} onClick={() => setSelectedCategory(c.id)} style={{ padding: "6px 14px", border: "1px solid", borderColor: selectedCategory === c.id ? "#1e3a5f" : "#d1d5db", borderRadius: 20, background: selectedCategory === c.id ? "#1e3a5f" : "white", color: selectedCategory === c.id ? "white" : "#374151", cursor: "pointer", fontSize: 12, fontWeight: selectedCategory === c.id ? 600 : 400 }}>
                      {c.icon} {c.label}
                    </button>
                  ))}
                </div>
                <h2 style={{ fontSize: "1.2rem", fontWeight: "normal", marginBottom: 16, color: "#1e3a5f" }}>
                  Rankings: {categories.find(c => c.id === selectedCategory)?.label}
                </h2>
                <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                  {ranked.map((d, i) => {
                    const cat = d[selectedCategory];
                    const score = cat?.score || 0;
                    const color = score >= 4 ? "#16a34a" : score === 3 ? "#ca8a04" : "#dc2626";
                    return (
                      <div key={d.id} onClick={() => { setSelectedDest(d); setView("detail"); }}
                        style={{ display: "flex", alignItems: "flex-start", gap: 14, padding: "14px 16px", background: "white", border: "1px solid #e2e8f0", borderLeft: `4px solid ${color}`, borderRadius: 8, cursor: "pointer" }}
                        onMouseEnter={e => e.currentTarget.style.boxShadow = "0 2px 8px rgba(0,0,0,0.1)"}
                        onMouseLeave={e => e.currentTarget.style.boxShadow = "none"}>
                        <div style={{ width: 32, height: 32, borderRadius: "50%", background: color, color: "white", display: "flex", alignItems: "center", justifyContent: "center", fontWeight: "bold", fontSize: 14, flexShrink: 0 }}>{i + 1}</div>
                        <div style={{ flex: 1 }}>
                          <div style={{ display: "flex", alignItems: "center", gap: 8, marginBottom: 4, flexWrap: "wrap" }}>
                            <span style={{ fontSize: 18 }}>{d.flag}</span>
                            <strong style={{ fontSize: 14 }}>{d.name}</strong>
                            {cat?.label && <span style={{ fontSize: 10, padding: "2px 6px", background: color + "20", color: color, borderRadius: 4, fontWeight: 600 }}>{cat.label}</span>}
                            <div style={{ marginLeft: "auto" }}><ScoreDots score={score} /></div>
                          </div>
                          <p style={{ margin: 0, fontSize: 12, color: "#555", lineHeight: 1.5 }}>{cat?.summary || "See details"}</p>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}

            {/* DETAIL */}
            {view === "detail" && (
              <div>
                <div style={{ display: "flex", flexWrap: "wrap", gap: 8, marginBottom: 20 }}>
                  {destinations.map(d => (
                    <button key={d.id} onClick={() => setSelectedDest(d)} style={{ padding: "5px 12px", border: "1px solid", borderColor: selectedDest?.id === d.id ? "#1e3a5f" : "#d1d5db", borderRadius: 20, background: selectedDest?.id === d.id ? "#1e3a5f" : "white", color: selectedDest?.id === d.id ? "white" : "#374151", cursor: "pointer", fontSize: 11 }}>
                      {d.flag} {d.name}
                    </button>
                  ))}
                </div>
                {!selectedDest ? (
                  <p style={{ color: "#666" }}>Select a destination above to view full details.</p>
                ) : (
                  <div style={{ background: "white", border: "1px solid #e2e8f0", borderRadius: 12, overflow: "hidden" }}>
                    <div style={{ padding: "1.5rem", background: "linear-gradient(135deg, #1e3a5f, #2d5986)", color: "white" }}>
                      <div style={{ fontSize: 36, marginBottom: 4 }}>{selectedDest.flag}</div>
                      <h2 style={{ margin: 0, fontWeight: "normal", fontSize: "1.6rem" }}>{selectedDest.name}</h2>
                      <p style={{ margin: "4px 0 0 0", color: "#b8cfe8", fontSize: 13 }}>{selectedDest.tagline}</p>
                      <div style={{ display: "flex", gap: 8, marginTop: 12, flexWrap: "wrap" }}>
                        {categories.map(c => {
                          const score = selectedDest[c.id]?.score || 0;
                          const color = score >= 4 ? "#4ade80" : score === 3 ? "#fbbf24" : "#f87171";
                          return (
                            <div key={c.id} style={{ fontSize: 10, padding: "3px 8px", background: "rgba(255,255,255,0.1)", borderRadius: 4, color: color, border: `1px solid ${color}40` }}>
                              {c.icon} {score}/5
                            </div>
                          );
                        })}
                      </div>
                    </div>
                    <div style={{ padding: "1.5rem", display: "flex", flexDirection: "column", gap: 20 }}>
                      <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12 }}>
                        <div style={{ padding: "1rem", background: "#f0fdf4", borderRadius: 8, border: "1px solid #bbf7d0" }}>
                          <strong style={{ fontSize: 12, color: "#166534", display: "block", marginBottom: 8 }}>✅ Pros</strong>
                          {selectedDest.pros.map((p, i) => <div key={i} style={{ fontSize: 12, color: "#166534", marginBottom: 4 }}>• {p}</div>)}
                        </div>
                        <div style={{ padding: "1rem", background: "#fef2f2", borderRadius: 8, border: "1px solid #fecaca" }}>
                          <strong style={{ fontSize: 12, color: "#991b1b", display: "block", marginBottom: 8 }}>⚠️ Cons</strong>
                          {selectedDest.cons.map((c, i) => <div key={i} style={{ fontSize: 12, color: "#991b1b", marginBottom: 4 }}>• {c}</div>)}
                        </div>
                      </div>
                      {categories.map(cat => {
                        const data = selectedDest[cat.id];
                        if (!data) return null;
                        const score = data.score || 0;
                        const color = score >= 4 ? "#16a34a" : score === 3 ? "#ca8a04" : "#dc2626";
                        return (
                          <div key={cat.id} style={{ borderTop: "1px solid #e8eef4", paddingTop: 16 }}>
                            <div style={{ display: "flex", alignItems: "center", gap: 8, marginBottom: 8, flexWrap: "wrap" }}>
                              <span style={{ fontSize: 18 }}>{cat.icon}</span>
                              <strong style={{ fontSize: 14 }}>{cat.label}</strong>
                              <ScoreDots score={score} />
                              {data.label && <span style={{ fontSize: 10, padding: "2px 8px", background: color + "15", color: color, borderRadius: 4, border: `1px solid ${color}30`, fontWeight: 600 }}>{data.label}</span>}
                            </div>
                            <p style={{ margin: "0 0 8px 0", fontSize: 13, color: "#333" }}>{data.summary}</p>
                            {data.details && (
                              <ul style={{ margin: 0, paddingLeft: 18, fontSize: 12, color: "#555", lineHeight: 1.8 }}>
                                {data.details.map((detail, i) => (
                                  <li key={i} style={{ color: detail.includes("⚠️") || detail.includes("START") ? "#dc2626" : "#555" }}>{detail}</li>
                                ))}
                              </ul>
                            )}
                            {cat.id === "cost" && data.monthly && (
                              <div style={{ marginTop: 8, display: "flex", gap: 12, flexWrap: "wrap" }}>
                                <div style={{ fontSize: 12, padding: "6px 12px", background: "#f0f9ff", borderRadius: 6, border: "1px solid #bae6fd" }}><strong>Monthly total:</strong> {data.monthly}</div>
                                <div style={{ fontSize: 12, padding: "6px 12px", background: "#f0f9ff", borderRadius: 6, border: "1px solid #bae6fd" }}><strong>Rent (2BR):</strong> {data.rent}</div>
                              </div>
                            )}
                            {cat.id === "flights" && data.hub && (
                              <div style={{ fontSize: 12, marginTop: 6, padding: "6px 10px", background: "#fafaf0", borderRadius: 6, border: "1px solid #e0e0a0", color: "#555" }}>Route: {data.hub}</div>
                            )}
                          </div>
                        );
                      })}
                    </div>
                  </div>
                )}
              </div>
            )}
          </div>

          <div style={{ textAlign: "center", padding: "2rem 1rem", fontSize: 11, color: "#999", borderTop: "1px solid #e8eef4", marginTop: 32 }}>
            Based on research through March 2026 • Visa rules and costs change frequently — verify with consulates before planning • This is not legal or immigration advice
          </div>
        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById("root")).render(<App />);
  </script>

</body>
